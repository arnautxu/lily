---
import { ui, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
---

<section id="com-treballem" class="section scroll-mt-24 bg-ink text-bg">
  <div class="container-edge">
    <div class="grid items-end gap-8 md:grid-cols-[1.2fr_1fr]">
      <div>
        <p class="eyebrow border-white/10 bg-white/5 text-coral" data-reveal>{t.process.eyebrow}</p>
        <h2 class="mt-5 max-w-2xl text-h2 font-semibold text-bg" data-reveal>{t.process.title}</h2>
      </div>
      <p class="lead text-bg/70" data-reveal>{t.process.lead}</p>
    </div>

    <!-- Sticky stack (GSAP escala les targetes anteriors en scroll) -->
    <div class="section-body relative" data-stack>
      {
        t.process.steps.map((step, i) => (
          <article
            class="sticky top-28 mb-5 origin-top overflow-hidden rounded-2xl border border-white/10 bg-[#16130f] p-7 md:p-10"
            data-stack-card
            style={`box-shadow: 0 -8px 40px -20px rgb(0 0 0 / 0.6);`}
          >
            <div class="grid gap-6 md:grid-cols-[auto_1fr] md:items-start md:gap-10">
              <span class="font-display text-display font-semibold text-accent">{step.n}</span>
              <div class="max-w-2xl">
                <h3 class="font-display text-h3 font-semibold text-bg">{step.title}</h3>
                <p class="mt-3 text-bg/70 md:text-lg">{step.body}</p>
                <div
                  class="mt-6 h-px w-full bg-gradient-to-r from-accent/60 to-transparent"
                  aria-hidden="true"
                />
                <p class="label mt-3 text-bg/35">
                  {String(i + 1).padStart(2, '0')} / {String(t.process.steps.length).padStart(2, '0')}
                </p>
              </div>
            </div>
          </article>
        ))
      }
    </div>

    <p class="mt-10 max-w-xl text-sm text-bg/55" data-reveal>
      {
        lang === 'ca'
          ? 'En cap moment es publica res sense que tu ho hagis revisat. Aquesta és la diferència amb un bot.'
          : 'En ningún momento se publica nada sin que tú lo hayas revisado. Esa es la diferencia con un bot.'
      }
    </p>
  </div>
</section>
