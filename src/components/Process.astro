---
import { ui, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
---

<section id="com-treballem" class="grain-inset relative scroll-mt-24 overflow-hidden bg-bg-deep py-24 md:py-32">
  <div class="container-edge relative z-10">
    <div class="max-w-2xl">
      <p class="eyebrow text-coral" data-reveal>{t.process.eyebrow}</p>
      <h2 class="mt-5 text-h2" data-reveal>{t.process.title}</h2>
      <p class="mt-5 text-lg text-ink-soft" data-reveal>{t.process.lead}</p>
    </div>

    <!-- Sticky stack (GSAP escala les targetes anteriors en scroll) -->
    <div class="relative mt-16" data-stack>
      {
        t.process.steps.map((step) => (
          <article
            class="sticky top-28 mb-5 origin-top overflow-hidden rounded-2xl border border-ink/10 bg-surface p-7 md:p-10"
            data-stack-card
            style={`box-shadow: 0 -8px 40px -20px oklch(0 0 0 / 0.5);`}
          >
            <div class="grid gap-6 md:grid-cols-[auto_1fr] md:items-start md:gap-10">
              <span class="font-display text-5xl text-accent md:text-7xl">{step.n}</span>
              <div class="max-w-2xl">
                <h3 class="font-display text-2xl text-ink md:text-3xl">{step.title}</h3>
                <p class="mt-3 text-ink-soft md:text-lg">{step.body}</p>
                <div class="mt-6 h-px w-full bg-accent/40" data-stack-rule aria-hidden="true" />
              </div>
            </div>
          </article>
        ))
      }
    </div>

    <p class="mt-10 max-w-xl text-sm text-ink-soft/80" data-reveal>
      {
        lang === 'ca'
          ? 'En cap pas es publica res sense que una persona ho hagi revisat i tu ho hagis vist. Aquesta és la diferència amb un bot.'
          : 'En ningún paso se publica nada sin que una persona lo haya revisado y tú lo hayas visto. Esa es la diferencia con un bot.'
      }
    </p>
  </div>
</section>
