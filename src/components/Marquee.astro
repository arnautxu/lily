---
import type { Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const items =
  lang === 'ca'
    ? ['Restaurants', 'Perruqueries', 'Pediatria', 'Botigues de roba', 'Lutheria', 'Gimnasos', 'Clíniques de salut', 'Cafeteries', 'Floristeries']
    : ['Restaurantes', 'Peluquerías', 'Pediatría', 'Tiendas de ropa', 'Luthería', 'Gimnasios', 'Clínicas de salud', 'Cafeterías', 'Floristerías'];

// Duplicat per al loop continu (GSAP fa el wrap a -50%)
const loop = [...items, ...items];
---

<section class="overflow-hidden border-y border-sand/50 py-8 md:py-10" aria-hidden="true">
  <div class="marquee-mask overflow-hidden">
    <div class="flex w-max items-center gap-10 will-change-transform md:gap-16" data-marquee-track>
      {
        loop.map((item, i) => (
          <span
            class={`flex items-center gap-10 whitespace-nowrap font-display text-3xl md:gap-16 md:text-5xl ${
              i % 2 === 0 ? 'text-ink' : 'italic text-ink-soft/80'
            }`}
          >
            {item}
            <span class="h-2 w-2 rounded-full bg-coral/70"></span>
          </span>
        ))
      }
    </div>
  </div>
</section>
<p class="sr-only">
  {lang === 'ca'
    ? 'Treballo amb restaurants, perruqueries, pediatria, botigues de roba, lutheria, gimnasos i clíniques de salut de tot Catalunya.'
    : 'Trabajo con restaurantes, peluquerías, pediatría, tiendas de ropa, luthería, gimnasios y clínicas de salud de toda Cataluña.'}
</p>
