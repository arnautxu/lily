---
import type { Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const items =
  lang === 'ca'
    ? ['Restaurants', 'Perruqueries', 'Pediatria', 'Botigues de roba', 'Lutheria', 'Gimnasos', 'Clíniques de salut', 'Cafeteries', 'Floristeries']
    : ['Restaurantes', 'Peluquerías', 'Pediatría', 'Tiendas de ropa', 'Luthería', 'Gimnasios', 'Clínicas de salud', 'Cafeterías', 'Floristerías'];

// Duplicat per al loop continu
const loop = [...items, ...items];
---

<section class="border-y border-sand/70 bg-surface/40 py-5" aria-hidden="true">
  <div class="marquee-mask overflow-hidden">
    <div class="marquee">
      {
        loop.map((item) => (
          <span class="flex items-center gap-12 whitespace-nowrap font-display text-xl text-ink-soft md:text-2xl">
            {item}
            <span class="h-1.5 w-1.5 rounded-full bg-coral/70"></span>
          </span>
        ))
      }
    </div>
  </div>
</section>
<p class="sr-only">
  {lang === 'ca'
    ? 'Treballo amb restaurants, perruqueries, pediatria, botigues de roba, lutheria, gimnasos i clíniques de salut de tot Catalunya.'
    : 'Trabajo con restaurantes, peluquerías, pediatría, tiendas de ropa, luthería, gimnasios y clínicas de salud de toda Cataluña.'}
</p>
