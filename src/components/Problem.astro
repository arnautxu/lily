---
import { ui, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
---

<section class="border-y border-sand/50 bg-sand/25 py-20 md:py-28">
  <div class="container-edge">
    <div class="mx-auto max-w-2xl text-center">
      <p class="eyebrow justify-center" data-reveal>{t.problem.eyebrow}</p>
      <h2 class="mt-4 text-h2 font-semibold" data-reveal>{t.problem.title}</h2>
      <p class="mt-4 text-lg text-ink-soft" data-reveal>{t.problem.lead}</p>
    </div>

    <ul class="mt-14 grid gap-5 md:grid-cols-3">
      {
        t.problem.items.map((item, i) => (
          <li class="card" data-reveal data-lift>
            <span class="font-display text-3xl font-semibold text-accent/40">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3 class="mt-3 text-h3 font-semibold">{item.title}</h3>
            <p class="mt-2 text-ink-soft">{item.body}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
