---
import { ui, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];

const indents = ['md:ml-0', 'md:ml-[12%]', 'md:ml-[24%]'];
---

<section class="py-28 md:py-40">
  <div class="container-edge">
    <p class="font-display text-2xl italic text-coral md:text-3xl" data-reveal>
      {t.problem.eyebrow}
    </p>
    <h2
      class="mt-6 max-w-4xl font-display text-[clamp(2.4rem,1.5rem+4.5vw,5.2rem)] leading-[1.02]"
      data-split-lines
    >
      {t.problem.title}
    </h2>
    <p class="mt-8 max-w-xl text-lg text-ink-soft" data-reveal>{t.problem.lead}</p>

    <div class="mt-20 flex flex-col gap-16 md:mt-28 md:gap-20">
      {
        t.problem.items.map((item, i) => (
          <article class={`relative max-w-xl ${indents[i]}`} data-reveal>
            <span
              class="pointer-events-none absolute -left-4 -top-12 select-none font-display text-[6rem] leading-none text-ink/[0.06] md:-left-16 md:text-[8rem]"
              aria-hidden="true"
            >
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3 class="relative font-display text-2xl text-ink md:text-3xl">{item.title}</h3>
            <p class="relative mt-3 text-ink-soft md:text-lg">{item.body}</p>
            <div class="mt-8 h-px w-full bg-sand" data-rule-reveal aria-hidden="true" />
          </article>
        ))
      }
    </div>
  </div>
</section>
