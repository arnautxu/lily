---
import { ui, type Lang } from '../lib/i18n';
import EtSonaRotator from './react/EtSonaRotator.tsx';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
---

<section class="section">
  <div class="container-edge">
    <div class="grid items-end gap-8 md:grid-cols-[1.3fr_1fr]">
      <div>
        <p class="eyebrow" data-reveal>{t.problem.eyebrow}</p>
        <h2 class="mt-5 max-w-2xl text-h2 font-semibold" data-reveal>{t.problem.title}</h2>
      </div>
      <p class="lead" data-reveal>{t.problem.lead}</p>
    </div>

    <!-- Un sol text que va canviant (flip-text de Vengeance UI · illa React) -->
    <div class="mt-16 md:mt-20" data-reveal>
      <EtSonaRotator client:visible items={t.problem.items} label={t.problem.eyebrow} />
    </div>
  </div>
</section>
