---
import { ui, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
---

<section class="py-24 md:py-32">
  <div class="container-edge">
    <div class="mx-auto max-w-3xl text-center">
      <p class="font-display text-[clamp(2rem,1.4rem+2.6vw,3.4rem)] font-medium italic text-accent-ink" data-reveal>
        {t.problem.eyebrow}
      </p>
      <h2 class="mt-4 text-h2 font-semibold" data-reveal>{t.problem.title}</h2>
      <p class="mx-auto mt-5 max-w-xl text-lg text-ink-soft" data-reveal>{t.problem.lead}</p>
    </div>

    <div class="mt-14 grid gap-4 md:grid-cols-6 md:grid-rows-2">
      {
        t.problem.items.map((item, i) => (
          <article
            class={`card flex flex-col justify-between gap-10 ${
              i === 0 ? 'md:col-span-4 md:row-span-2 md:gap-16' : 'md:col-span-2'
            }`}
            data-reveal
            data-lift
          >
            <span class={`font-display font-semibold text-accent/25 ${i === 0 ? 'text-7xl' : 'text-4xl'}`}>
              {String(i + 1).padStart(2, '0')}
            </span>
            <div>
              <h3 class={`font-semibold ${i === 0 ? 'text-2xl md:text-3xl' : 'text-h3'}`}>{item.title}</h3>
              <p class="mt-2 text-ink-soft">{item.body}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
