---
import { ui, type Lang } from '../lib/i18n';
import { faq } from '../data/faq';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
const items = faq[lang];
---

<section class="border-t border-sand py-24 md:py-32">
  <div class="container-edge grid gap-10 lg:grid-cols-[0.6fr_1fr] lg:gap-16">
    <div class="lg:sticky lg:top-24 lg:self-start">
      <p class="eyebrow" data-reveal>{t.faq.eyebrow}</p>
      <h2 class="mt-4 text-h2 font-semibold" data-reveal>{t.faq.title}</h2>
    </div>

    <div class="divide-y divide-sand/70" data-reveal>
      {
        items.map((item) => (
          <details class="group py-5" data-faq>
            <summary
              class="flex cursor-pointer list-none items-center justify-between gap-4 text-lg font-medium text-ink transition-colors hover:text-accent-ink"
            >
              {item.q}
              <span
                class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full border border-sand text-accent-ink transition-transform duration-300 group-open:rotate-45"
                aria-hidden="true"
              >
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round">
                  <path d="M12 5v14M5 12h14" />
                </svg>
              </span>
            </summary>
            <div class="faq-answer">
              <div>
                <p class="mt-3 max-w-2xl leading-relaxed text-ink-soft">{item.a}</p>
              </div>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<script>
  // Anima l'obrir/tancar dels <details> mantenint la semàntica nativa:
  // en obrir, posem `open` i després la classe que dispara la transició de
  // grid-template-rows; en tancar, invertim i esperem el transitionend.
  document.querySelectorAll<HTMLDetailsElement>('[data-faq]').forEach((details) => {
    const summary = details.querySelector('summary');
    const answer = details.querySelector<HTMLElement>('.faq-answer');
    if (!summary || !answer) return;

    summary.addEventListener('click', (e) => {
      e.preventDefault();
      if (details.open) {
        details.classList.remove('is-open');
        const finish = () => {
          if (!details.classList.contains('is-open')) details.open = false;
        };
        answer.addEventListener('transitionend', finish, { once: true });
        // Fallback si la transició no es dispara (reduced motion, interrupcions)
        setTimeout(finish, 450);
      } else {
        details.open = true;
        // Reflow forçat perquè la transició parteixi de 0fr
        void answer.offsetHeight;
        details.classList.add('is-open');
      }
    });
  });
</script>
