---
import { ui, type Lang } from '../lib/i18n';
import { portfolio } from '../data/portfolio';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
const pieces = portfolio[lang];
const tints = ['from-[#cf6b43] to-[#a8451f]', 'from-[#5d7d3a] to-[#385c22]', 'from-[#8a7a66] to-[#4b4036]'];
---

<section id="feina" class="aura scroll-mt-24 py-24 md:py-32">
  <div class="container-edge">
    <div class="grid items-end gap-8 md:grid-cols-[1.3fr_1fr]">
      <div>
        <p class="eyebrow" data-reveal>{t.portfolio.eyebrow}</p>
        <h2 class="mt-5 max-w-2xl text-h2 font-semibold" data-reveal>{t.portfolio.title}</h2>
      </div>
      <p class="text-lg text-ink-soft md:pb-1" data-reveal>{t.portfolio.lead}</p>
    </div>

    <div class="mt-14 grid gap-6 md:grid-cols-3">
      {
        pieces.map((piece, i) => (
          <figure class="group" data-reveal>
            <div class="bezel" data-tilt>
              <div class="bezel-core overflow-hidden">
                <div class={`relative aspect-[4/5] bg-gradient-to-br ${tints[i]} overflow-hidden`}>
                  {/* PLACEHOLDER · <img src={piece.image} alt={piece.imageAlt} width="640" height="800"
                       loading="lazy" class="h-full w-full object-cover" /> */}
                  <span class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-ink/55 to-transparent p-4 text-xs font-medium text-white/90">
                    {t.portfolio.placeholderNote}
                  </span>
                </div>
              </div>
            </div>
            <figcaption class="mt-5 px-1">
              <p class="text-xs font-semibold uppercase tracking-[0.14em] text-accent-ink">{piece.sector}</p>
              <p class="mt-1.5 font-display text-xl font-semibold">{piece.client}</p>
              <p class="mt-1 text-sm text-ink-soft">{piece.result}</p>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>
