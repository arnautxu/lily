---
import { Image, getImage } from 'astro:assets';
import { ui, type Lang } from '../lib/i18n';
import { CylinderCarousel } from './react/CylinderCarousel.tsx';
import MetricsCarousel from './react/MetricsCarousel.tsx';
import Lightbox from './Lightbox.astro';
import luthier from '../assets/guitarras/luthier-retrat.png';
import flatlay from '../assets/guitarras/flatlay-tapa.png';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
const cs = t.portfolio.caseStudy;
const ms = t.portfolio.moreSamples;
const zoom = t.portfolio.zoom;

// Versions grans per al visor a pantalla completa (morph amb View Transitions).
const portraitZoom = (await getImage({ src: luthier, width: 1400 })).src;
const bannerZoom = (await getImage({ src: flatlay, width: 1600 })).src;

// Mostres d'altres comptes (src/assets/noves), optimitzades per al carrusel cilíndric.
const sampleMods = import.meta.glob('../assets/noves/*.png', { eager: true, import: 'default' });
const sampleImages = await Promise.all(
  Object.entries(sampleMods)
    .sort(([a], [b]) => a.localeCompare(b))
    .map(async ([, mod], i) => {
      const img = await getImage({ src: mod as Parameters<typeof getImage>[0]['src'], width: 560 });
      return { src: img.src, alt: `${ms.tag} · ${i + 1}` };
    }),
);

// Totes les fotos reals (feed + taller) per al CylinderCarousel, optimitzades.
const galleryMods = {
  ...import.meta.glob('../assets/feed/*.jpeg', { eager: true, import: 'default' }),
  ...import.meta.glob('../assets/guitarras/*.png', { eager: true, import: 'default' }),
};
const galleryEntries = Object.entries(galleryMods).sort(([a], [b]) => a.localeCompare(b));
const feedImages = await Promise.all(
  galleryEntries.map(async ([, mod], i) => {
    const img = await getImage({ src: mod as Parameters<typeof getImage>[0]['src'], width: 560 });
    return { src: img.src, alt: `${cs.tag} · ${i + 1}` };
  }),
);

const blocks = [
  { label: cs.challengeLabel, body: cs.challenge },
  { label: cs.approachLabel, body: cs.approach },
  { label: cs.resultLabel, body: cs.result },
];

// Mètriques per al carrusel (dades serialitzables → la illa hi posa icones).
const statN = parseFloat(cs.resultStat.replace(/[^\d.]/g, '')) || 0;
const statPrefix = cs.resultStat.replace(/[\d.].*$/, '');
const metricIcons = ['reach', 'likes', 'users'] as const;
const metricsData = [
  { prefix: statPrefix, value: String(statN), suffix: '', label: cs.resultStatLabel, icon: 'chat' },
  ...cs.metrics.map((m, i) => ({
    prefix: m.prefix,
    value: String(m.n),
    suffix: m.suffix,
    label: m.label,
    icon: metricIcons[i] ?? 'reach',
  })),
];
---

<section id="feina" class="aura scroll-mt-24 section">
  <div class="container-edge">
    <!-- Capçalera secció -->
    <div class="grid items-end gap-8 md:grid-cols-[1.3fr_1fr]">
      <div>
        <p class="eyebrow" data-reveal>{t.portfolio.eyebrow}</p>
        <h2 class="mt-5 max-w-2xl text-h2 font-semibold" data-reveal>{t.portfolio.title}</h2>
      </div>
      <p class="lead" data-reveal>{t.portfolio.lead}</p>
    </div>

    <!-- ── Case study ──────────────────────────────────────── -->
    <article class="mt-16">
      <p class="eyebrow" data-reveal>
        <span class="inline-block h-1.5 w-1.5 rounded-full bg-coral"></span>
        {cs.tag}
      </p>

      <!-- Split: retrat + relat -->
      <div class="mt-6 grid items-center gap-8 lg:grid-cols-[0.92fr_1.08fr] lg:gap-14">
        <figure class="bezel" data-tilt data-reveal>
          <div class="zoomable bezel-core relative aspect-[4/5] overflow-hidden">
            <Image
              src={luthier}
              alt={cs.portraitAlt}
              widths={[480, 900]}
              sizes="(max-width: 1024px) 90vw, 440px"
              class="absolute inset-0 h-full w-full object-cover"
              data-zoom
              data-zoom-src={portraitZoom}
              data-zoom-caption={cs.portraitAlt}
              role="button"
              tabindex="0"
              aria-label={`${zoom.open} — ${cs.portraitAlt}`}
            />
            <span class="zoom-hint" aria-hidden="true">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7" /><path d="m21 21-4.3-4.3M11 8v6M8 11h6" /></svg>
            </span>
          </div>
        </figure>

        <div class="max-w-xl" data-reveal>
          <h3 class="font-display text-h2 font-semibold leading-[1.05]">{cs.title}</h3>
          <p class="mt-5 text-lg leading-relaxed text-ink-soft">{cs.intro}</p>

          <dl class="mt-8 grid gap-6 sm:grid-cols-3">
            {
              blocks.map((b) => (
                <div>
                  <dt class="text-[0.72rem] font-semibold uppercase tracking-[0.14em] text-accent-ink">
                    {b.label}
                  </dt>
                  <dd class="mt-2 text-[0.95rem] leading-relaxed text-ink-soft">{b.body}</dd>
                </div>
              ))
            }
          </dl>

        </div>
      </div>

      <!-- ── Resultats · card de mètriques (liquid glass) sobre el carrusel circular ── -->
      <div class="section-body" data-reveal>
        <div class="mx-auto max-w-xl text-center">
          <p class="label inline-flex items-center gap-2 text-accent-ink">
            <span class="inline-block h-1.5 w-1.5 rounded-full bg-accent"></span>
            {cs.resultsTitle}
          </p>
          <h3 class="mt-3 text-h2 font-semibold">
            {lang === 'ca' ? 'Números que parlen sols.' : 'Números que hablan solos.'}
          </h3>
        </div>

        <!-- Mòbil: carrusel a dalt + dades a sota · Desktop: card centrada a sobre -->
        <div class="relative mt-10 overflow-hidden md:mt-12">
          <CylinderCarousel
            className="min-h-[360px] md:min-h-[500px]"
            images={feedImages}
            cardWidth={240}
            animationDuration={42}
          />
          <div
            class="mt-6 flex justify-center px-4 md:pointer-events-none md:absolute md:inset-0 md:mt-0 md:items-center"
          >
            <div class="pointer-events-auto flex w-full max-w-[340px] justify-center">
              <MetricsCarousel client:idle metrics={metricsData} baseWidth={300} />
            </div>
          </div>
        </div>

        {cs.resultsNote && (
          <p class="mx-auto mt-6 max-w-md text-center text-sm text-ink-soft/90">{cs.resultsNote}</p>
        )}
      </div>

      <!-- Banner flat-lay + pull quote -->
      <figure class="mt-4 overflow-hidden rounded-2xl" data-reveal>
        <div class="zoomable relative max-h-[28rem] overflow-hidden">
          <Image
            src={flatlay}
            alt={cs.bannerCaption}
            widths={[768, 1280, 1600]}
            sizes="(max-width: 1280px) 100vw, 1216px"
            class="banner-parallax h-full max-h-[28rem] w-full object-cover"
            data-zoom
            data-zoom-src={bannerZoom}
            data-zoom-caption={cs.bannerCaption}
            role="button"
            tabindex="0"
            aria-label={`${zoom.open} — ${cs.bannerCaption}`}
          />
          <div class="pointer-events-none absolute inset-0 bg-gradient-to-tr from-ink/75 via-ink/30 to-transparent"></div>
          <figcaption class="pointer-events-none absolute inset-0 flex flex-col justify-end gap-3 p-6 md:max-w-xl md:p-10">
            <p class="font-display text-2xl font-semibold leading-snug text-bg md:text-3xl">{cs.quote}</p>
            {cs.quoteAuthor && <p class="text-sm text-bg/70">{cs.quoteAuthor}</p>}
          </figcaption>
          <span class="zoom-hint" aria-hidden="true">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7" /><path d="m21 21-4.3-4.3M11 8v6M8 11h6" /></svg>
          </span>
        </div>
        <figcaption class="px-1 pt-3 text-[0.78rem] text-ink-soft">{cs.bannerCaption}</figcaption>
      </figure>
    </article>

    <!-- ── Més mostres · galeria d'altres comptes ──────────────── -->
    <div class="mt-24 border-t border-ink/10 pt-14 md:mt-28 md:pt-16">
      <div class="grid items-end gap-8 md:grid-cols-[1.3fr_1fr]">
        <div>
          <p class="eyebrow" data-reveal>
            <span class="inline-block h-1.5 w-1.5 rounded-full bg-accent"></span>
            {ms.eyebrow}
          </p>
          <h3 class="mt-5 max-w-2xl text-h2 font-semibold" data-reveal>{ms.title}</h3>
        </div>
        <p class="lead" data-reveal>{ms.lead}</p>
      </div>

      <div class="relative mt-10 overflow-hidden md:mt-12" data-reveal>
        <CylinderCarousel
          className="min-h-[320px] md:min-h-[440px]"
          images={sampleImages}
          cardWidth={200}
          animationDuration={58}
          reverse
        />
      </div>
    </div>
  </div>
</section>

<Lightbox closeLabel={zoom.close} />

<style>
  /* Afordança de "ampliar" sobre les fotos obribles. */
  .zoomable [data-zoom] {
    cursor: zoom-in;
  }
  .zoom-hint {
    position: absolute;
    top: 0.85rem;
    right: 0.85rem;
    z-index: 2;
    display: flex;
    height: 34px;
    width: 34px;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    background: rgb(12 11 9 / 0.5);
    color: rgb(var(--bg));
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    opacity: 0;
    transform: scale(0.8);
    transition:
      opacity 0.3s var(--ease-soft),
      transform 0.3s var(--ease-soft);
    pointer-events: none;
  }
  .zoomable:hover .zoom-hint,
  [data-zoom]:focus-visible ~ .zoom-hint {
    opacity: 1;
    transform: scale(1);
  }
  /* A tàctil (sense hover fi) mostra sempre el hint, discret. */
  @media (hover: none) {
    .zoom-hint {
      opacity: 0.9;
      transform: scale(1);
    }
  }

  /* Parallax cinematogràfic del banner lligat a l'scroll (amb fallback estàtic). */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .banner-parallax {
        transform-origin: center;
        animation: banner-pan linear both;
        animation-timeline: view();
        animation-range: cover 0% cover 100%;
      }
      @keyframes banner-pan {
        from {
          transform: scale(1.14) translateY(-2.5%);
        }
        to {
          transform: scale(1.14) translateY(2.5%);
        }
      }
    }
  }
</style>

<script>
  // Pausa els cilindres 3D quan són fora de pantalla (estalvia GPU/bateria).
  const tracks = document.querySelectorAll<HTMLElement>('[data-cyl-track]');
  if (tracks.length && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          (e.target as HTMLElement).style.animationPlayState = e.isIntersecting
            ? 'running'
            : 'paused';
        });
      },
      { rootMargin: '120px 0px' },
    );
    tracks.forEach((t) => io.observe(t));
  }
</script>
