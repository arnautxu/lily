---
import type { Lang } from '../lib/i18n';
import Nav from './Nav.astro';
import Hero from './Hero.astro';
import Marquee from './Marquee.astro';
import Problem from './Problem.astro';
import Services from './Services.astro';
import Process from './Process.astro';
import Pricing from './Pricing.astro';
import Portfolio from './Portfolio.astro';
import About from './About.astro';
import Faq from './Faq.astro';
import Contact from './Contact.astro';
import Footer from './Footer.astro';
import WhatsappFab from './WhatsappFab.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---

<Nav lang={lang} />
<main id="main">
  <Hero lang={lang} />
  <Marquee lang={lang} />
  <Problem lang={lang} />
  <Services lang={lang} />
  <Process lang={lang} />
  <Portfolio lang={lang} />
  <Pricing lang={lang} />
  <About lang={lang} />
  <Faq lang={lang} />
  <Contact lang={lang} />
</main>
<Footer lang={lang} />
<WhatsappFab lang={lang} />
