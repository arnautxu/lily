---
import { ui, type Lang } from '../lib/i18n';
import { whatsappLink } from '../lib/config';
import { pricing } from '../data/pricing';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
const wa = whatsappLink(lang);
const { tiers, extras } = pricing[lang];
---

<section id="tarifes" class="scroll-mt-20 py-20 md:py-28">
  <div class="container-edge">
    <div class="mx-auto max-w-2xl text-center">
      <p class="eyebrow justify-center" data-reveal>{t.pricing.eyebrow}</p>
      <h2 class="mt-4 text-h2 font-semibold" data-reveal>{t.pricing.title}</h2>
      <p class="mt-4 text-lg text-ink-soft" data-reveal>{t.pricing.lead}</p>
    </div>

    <div class="mt-14 grid items-start gap-5 lg:grid-cols-3">
      {
        tiers.map((tier) => (
          <article
            class={`card relative flex h-full flex-col ${tier.featured ? 'border-accent/60 shadow-lift ring-1 ring-accent/30' : ''}`}
            data-reveal
            data-lift
          >
            {tier.featured && (
              <span class="absolute -top-3 left-6 rounded-full bg-accent px-3 py-1 text-[0.72rem] font-semibold uppercase tracking-wide text-white">
                {t.pricing.featuredBadge}
              </span>
            )}
            <h3 class="font-display text-h3 font-semibold">{tier.name}</h3>
            <p class="mt-1 text-sm text-ink-soft">{tier.tagline}</p>
            <p class="mt-5 flex items-baseline gap-1">
              <span class="font-display text-4xl font-semibold text-ink">{tier.price}</span>
              <span class="text-sm text-ink-soft">{t.pricing.perMonth}</span>
            </p>
            <ul class="mt-6 flex flex-1 flex-col gap-3 text-[0.95rem]">
              {tier.features.map((f) => (
                <li class="flex items-start gap-2.5">
                  <svg class="mt-0.5 shrink-0 text-accent-ink" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M20 6 9 17l-5-5" />
                  </svg>
                  <span class="text-ink-soft">{f}</span>
                </li>
              ))}
            </ul>
            <a
              href={wa}
              rel="noopener"
              class={`mt-7 ${tier.featured ? 'btn-primary' : 'btn-secondary'} w-full`}
            >
              {t.pricing.cta}
            </a>
          </article>
        ))
      }
    </div>

    <!-- Extres -->
    <div class="mt-12 rounded-lg border border-sand/70 bg-sand/20 p-6 md:p-8" data-reveal>
      <h3 class="text-h3 font-semibold">{t.pricing.extrasTitle}</h3>
      <ul class="mt-5 grid gap-x-8 gap-y-3 sm:grid-cols-2">
        {
          extras.map((e) => (
            <li class="flex items-center justify-between gap-4 border-b border-sand/70 pb-3">
              <span class="text-ink-soft">{e.name}</span>
              <span class="font-display font-semibold text-ink">{e.price}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <p class="mx-auto mt-6 max-w-2xl text-center text-sm text-ink-soft/80" data-reveal>
      {t.pricing.note}
    </p>
  </div>
</section>
