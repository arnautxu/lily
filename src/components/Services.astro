---
import { ui, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
---

<section id="que-fem" class="scroll-mt-24 py-24 md:py-32">
  <div class="container-edge">
    <div class="grid items-end gap-8 md:grid-cols-[1.3fr_1fr]">
      <div>
        <p class="eyebrow-bare" data-reveal>{t.services.eyebrow}</p>
        <h2 class="mt-5 max-w-2xl text-h2 font-semibold" data-reveal>{t.services.title}</h2>
      </div>
      <p class="text-lg text-ink-soft md:pb-1" data-reveal>{t.services.lead}</p>
    </div>

    <!-- Índex editorial: files numerades amb hairlines -->
    <div class="mt-14 border-t border-sand">
      {
        t.services.items.map((item, i) => (
          <article
            class="group grid gap-3 border-b border-sand px-2 py-8 transition-colors duration-500 ease-out-soft hover:bg-surface md:grid-cols-[5rem_1fr_1.4fr] md:items-baseline md:gap-8 md:px-4 md:py-10"
            data-reveal
          >
            <span
              class="font-display text-3xl font-semibold text-accent/30 transition-colors duration-500 group-hover:text-accent md:text-4xl"
              aria-hidden="true"
            >
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3 class="font-display text-2xl font-semibold md:text-3xl">{item.title}</h3>
            <p class="text-ink-soft md:text-lg">{item.body}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
