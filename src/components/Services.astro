---
import { ui, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];

const icons = ['grid', 'play', 'pen', 'calendar'];
---

<section id="que-fem" class="scroll-mt-24 py-24 md:py-32">
  <div class="container-edge">
    <div class="grid items-end gap-8 md:grid-cols-[1.3fr_1fr]">
      <div>
        <p class="eyebrow" data-reveal>{t.services.eyebrow}</p>
        <h2 class="mt-5 max-w-2xl text-h2 font-semibold" data-reveal>{t.services.title}</h2>
      </div>
      <p class="text-lg text-ink-soft md:pb-1" data-reveal>{t.services.lead}</p>
    </div>

    <div class="mt-14 grid gap-4 sm:grid-cols-2">
      {
        t.services.items.map((item, i) => (
          <article class="card flex gap-5 md:p-8" data-reveal data-lift>
            <span
              class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-accent/[0.12] text-accent-ink"
              aria-hidden="true"
            >
              {icons[i] === 'grid' && (
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                  <rect x="3" y="3" width="7" height="7" rx="1.5" /><rect x="14" y="3" width="7" height="7" rx="1.5" /><rect x="3" y="14" width="7" height="7" rx="1.5" /><rect x="14" y="14" width="7" height="7" rx="1.5" />
                </svg>
              )}
              {icons[i] === 'play' && (
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                  <rect x="3" y="3" width="18" height="18" rx="4" /><path d="M10 9l5 3-5 3V9Z" fill="currentColor" stroke="none" />
                </svg>
              )}
              {icons[i] === 'pen' && (
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 20h9" /><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4 12.5-12.5Z" />
                </svg>
              )}
              {icons[i] === 'calendar' && (
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
                  <rect x="3" y="5" width="18" height="16" rx="2" /><path d="M3 9h18M8 3v4M16 3v4" />
                </svg>
              )}
            </span>
            <div>
              <h3 class="text-h3 font-semibold">{item.title}</h3>
              <p class="mt-1.5 text-ink-soft">{item.body}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
