---
import { ui, type Lang } from '../lib/i18n';
import { whatsappLink } from '../lib/config';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
const wa = whatsappLink(lang);

// Cel·les del mosaic-feed placeholder (substituïbles per fotos reals)
const tiles = [
  'bg-[#d98b6a]',
  'bg-[#e8dcc8]',
  'bg-[#9aa86f]',
  'bg-[#c65a36]',
  'bg-[#efe6d6]',
  'bg-[#7d6b5d]',
];
---

<section class="relative overflow-hidden">
  <!-- glow càlid de fons -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -right-32 -top-40 h-[34rem] w-[34rem] rounded-full bg-accent/10 blur-3xl"
  >
  </div>

  <div
    class="container-edge grid items-center gap-12 py-16 md:py-24 lg:grid-cols-[1.05fr_0.95fr] lg:gap-16"
  >
    <div class="max-w-xl">
      <p class="eyebrow" data-reveal>
        <span class="inline-block h-1.5 w-1.5 rounded-full bg-accent"></span>
        {t.hero.eyebrow}
      </p>
      <h1 class="mt-5 font-display text-display font-semibold" data-reveal>
        {t.hero.title}
      </h1>
      <p class="mt-6 text-lg leading-relaxed text-ink-soft" data-reveal>
        {t.hero.lead}
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row" data-reveal>
        <a href={wa} class="btn-primary" rel="noopener">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91S17.5 2 12.04 2Zm5.8 14.16c-.24.68-1.4 1.3-1.93 1.38-.49.07-1.12.1-1.8-.11-.42-.13-.95-.31-1.64-.61-2.88-1.24-4.76-4.14-4.9-4.33-.14-.19-1.17-1.56-1.17-2.97s.74-2.11 1-2.4c.26-.29.57-.36.76-.36l.55.01c.18.01.41-.07.64.49.24.58.82 2 .89 2.14.07.14.12.31.02.5-.1.19-.14.31-.29.48-.14.17-.3.38-.43.51-.14.14-.29.29-.12.58.17.29.74 1.22 1.59 1.98 1.09.97 2.01 1.27 2.3 1.42.29.14.46.12.63-.07.17-.19.72-.84.91-1.13.19-.29.39-.24.64-.14.26.09 1.66.78 1.95.93.29.14.48.21.55.34.07.12.07.72-.17 1.4Z" />
          </svg>
          {t.hero.ctaPrimary}
        </a>
        <a href="#feina" class="btn-secondary">{t.hero.ctaSecondary}</a>
      </div>
      <p class="mt-6 text-sm text-ink-soft/90" data-reveal>{t.hero.trust}</p>
    </div>

    <!-- Mosaic placeholder: substitueix per foto real / captures de feed -->
    <div class="relative" data-reveal>
      <div
        class="grid grid-cols-3 gap-3 rounded-lg border border-sand/70 bg-surface p-3 shadow-soft"
      >
        {
          tiles.map((c, i) => (
            <div
              class={`${c} aspect-square overflow-hidden ${i === 0 ? 'col-span-2 row-span-2' : ''}`}
              style={`border-radius: var(--r-sm)`}
            />
          ))
        }
      </div>
      <span
        class="absolute -bottom-3 left-1/2 -translate-x-1/2 whitespace-nowrap rounded-full border border-sand bg-bg px-3 py-1 text-[0.7rem] font-medium text-ink-soft"
      >
        {lang === 'ca' ? 'PLACEHOLDER · feed real del teu negoci' : 'PLACEHOLDER · feed real de tu negocio'}
      </span>
    </div>
  </div>
</section>
