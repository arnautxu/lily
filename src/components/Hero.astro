---
import { ui, type Lang } from '../lib/i18n';
import { whatsappLink } from '../lib/config';
import HeroScene from './three/HeroScene.tsx';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
const wa = whatsappLink(lang);

// Paraules per a les tiles tipogràfiques del núvol WebGL
const tileWords =
  lang === 'ca' ? ['Obert avui', 'Demana hora', 'Novetat'] : ['Abierto hoy', 'Pide hora', 'Novedad'];

// Pòster CSS: estat pre-hidratació + fallback sense WebGL / low-end
const posterTiles = [
  { c: '#cf6b43', x: '62%', y: '14%', s: 'w-36 md:w-48', blur: 'blur-[1px]', r: 'rotate-2' },
  { c: '#a8bd92', x: '82%', y: '38%', s: 'w-28 md:w-40', blur: '', r: '-rotate-2' },
  { c: '#171b14', x: '58%', y: '58%', s: 'w-24 md:w-32', blur: 'blur-[2px]', r: 'rotate-1' },
  { c: '#d8c9b2', x: '74%', y: '72%', s: 'w-32 md:w-44', blur: 'blur-[1px]', r: '-rotate-1' },
  { c: '#4d7c2f', x: '90%', y: '10%', s: 'w-20 md:w-28', blur: 'blur-[3px]', r: 'rotate-3' },
];
---

<section id="hero" class="relative flex min-h-[100svh] flex-col overflow-hidden bg-bg-deep">
  <!-- Pòster CSS (darrere el canvas) -->
  <div class="hero-poster absolute inset-0" aria-hidden="true">
    <div
      class="absolute inset-0"
      style="background: radial-gradient(60rem 40rem at 70% 40%, oklch(var(--surface)) 0%, oklch(var(--bg-deep)) 70%);"
    >
    </div>
    {
      posterTiles.map((p) => (
        <div
          class={`absolute aspect-square rounded-2xl ${p.s} ${p.blur} ${p.r}`}
          style={`left:${p.x}; top:${p.y}; background:${p.c}; opacity:0.85;`}
        />
      ))
    }
  </div>

  <!-- Escena WebGL (illa React) -->
  <div class="absolute inset-0">
    <HeroScene client:idle words={tileWords} />
  </div>

  <!-- Scrim de contrast per al text -->
  <div
    class="pointer-events-none absolute inset-0 z-[1] bg-gradient-to-r from-bg-deep/85 via-bg-deep/30 to-transparent"
    aria-hidden="true"
  >
  </div>

  <!-- Contingut -->
  <div class="container-edge relative z-10 flex flex-1 flex-col justify-end pb-20 pt-36 md:pb-28" data-hero-content>
    <p class="eyebrow w-fit" data-hero-fade>
      <span class="inline-block h-1.5 w-1.5 animate-float rounded-full bg-accent"></span>
      {t.hero.eyebrow}
    </p>

    <h1 class="mt-8 max-w-5xl font-display text-mega" data-hero-title>
      {t.hero.titlePre}
      <em class="italic text-coral">{t.hero.titleAccent}</em>
      {t.hero.titlePost}
    </h1>

    <p class="mt-7 max-w-md text-lg leading-relaxed text-ink-soft" data-hero-fade>
      {t.hero.lead}
    </p>

    <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:items-center" data-hero-fade>
      <a href={wa} rel="noopener" class="btn-primary" data-magnetic>
        {t.hero.ctaPrimary}
        <span class="btn-ico" aria-hidden="true">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91S17.5 2 12.04 2Zm5.8 14.16c-.24.68-1.4 1.3-1.93 1.38-.49.07-1.12.1-1.8-.11-.42-.13-.95-.31-1.64-.61-2.88-1.24-4.76-4.14-4.9-4.33-.14-.19-1.17-1.56-1.17-2.97s.74-2.11 1-2.4c.26-.29.57-.36.76-.36l.55.01c.18.01.41-.07.64.49.24.58.82 2 .89 2.14.07.14.12.31.02.5-.43.84-.88 1.05-.41.93-.12.58.17.29.74 1.22 1.59 1.98 1.09.97 2.01 1.27 2.3 1.42.29.14.46.12.63-.07.17-.19.72-.84.91-1.13.19-.29.39-.24.64-.14.26.09 1.66.78 1.95.93.29.14.48.21.55.34.07.12.07.72-.17 1.4Z"/></svg>
        </span>
      </a>
      <a href="#casos" class="btn-secondary" data-magnetic>
        {t.hero.ctaSecondary}
        <span class="btn-ico" aria-hidden="true">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </span>
      </a>
    </div>

    <p class="mt-8 text-sm text-ink-soft/80" data-hero-fade>{t.hero.trust}</p>
  </div>

  <!-- Indicador d'scroll -->
  <div class="absolute bottom-8 right-8 z-10 hidden flex-col items-center gap-3 md:flex" aria-hidden="true">
    <span class="text-[0.65rem] uppercase tracking-[0.25em] text-ink-soft/60">Scroll</span>
    <span class="scroll-cue block h-10 w-px bg-ink/25"></span>
  </div>
</section>

<style>
  /* Crossfade pòster → canvas quan l'escena ha pintat el primer frame */
  .hero-poster {
    opacity: 1;
    transition: opacity 0.6s var(--ease-soft);
  }
  section[data-scene-ready] .hero-poster {
    opacity: 0;
  }

  .scroll-cue {
    animation: cue 2.2s var(--ease-soft) infinite;
    transform-origin: top center;
  }
  @keyframes cue {
    0% { transform: scaleY(0); transform-origin: top center; }
    45% { transform: scaleY(1); transform-origin: top center; }
    55% { transform: scaleY(1); transform-origin: bottom center; }
    100% { transform: scaleY(0); transform-origin: bottom center; }
  }
</style>
