---
import { ui, type Lang } from '../lib/i18n';
import { whatsappLink } from '../lib/config';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
const wa = whatsappLink(lang);

// 6 cel·les que omplen una graella 3×3 perfecta (la primera és 2×2).
const tiles = [
  { c: 'bg-[#cf6b43]', span: 'col-span-2 row-span-2' },
  { c: 'bg-[#5d7d3a]', span: '' },
  { c: 'bg-[#e7dfd2]', span: '' },
  { c: 'bg-[#4d7c2f]', span: '' },
  { c: 'bg-[#d8c9b2]', span: '' },
  { c: 'bg-[#8a7a66]', span: '' },
];
---

<section class="aura relative overflow-hidden">
  <div
    class="container-edge grid items-center gap-12 pb-16 pt-32 md:pb-24 md:pt-40 lg:grid-cols-[1.05fr_0.95fr] lg:gap-14"
  >
    <div class="max-w-2xl">
      <p class="eyebrow" data-reveal>
        <span class="inline-block h-1.5 w-1.5 animate-float rounded-full bg-accent"></span>
        {t.hero.eyebrow}
      </p>
      <h1 class="mt-6 font-display text-mega font-semibold" data-reveal>
        {t.hero.title}
      </h1>
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-ink-soft" data-reveal>
        {t.hero.lead}
      </p>
      <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:items-center" data-reveal>
        <a href={wa} rel="noopener" class="btn-primary" data-magnetic>
          {t.hero.ctaPrimary}
          <span class="btn-ico" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91S17.5 2 12.04 2Zm5.8 14.16c-.24.68-1.4 1.3-1.93 1.38-.49.07-1.12.1-1.8-.11-.42-.13-.95-.31-1.64-.61-2.88-1.24-4.76-4.14-4.9-4.33-.14-.19-1.17-1.56-1.17-2.97s.74-2.11 1-2.4c.26-.29.57-.36.76-.36l.55.01c.18.01.41-.07.64.49.24.58.82 2 .89 2.14.07.14.12.31.02.5-.43.84-.88 1.05-.41.93-.12.58.17.29.74 1.22 1.59 1.98 1.09.97 2.01 1.27 2.3 1.42.29.14.46.12.63-.07.17-.19.72-.84.91-1.13.19-.29.39-.24.64-.14.26.09 1.66.78 1.95.93.29.14.48.21.55.34.07.12.07.72-.17 1.4Z"/></svg>
          </span>
        </a>
        <a href="#feina" class="btn-secondary" data-magnetic>
          {t.hero.ctaSecondary}
          <span class="btn-ico" aria-hidden="true">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </span>
        </a>
      </div>
      <p class="mt-7 text-sm text-ink-soft/90" data-reveal>{t.hero.trust}</p>
    </div>

    <!-- Bento de feed (double-bezel) — PLACEHOLDER fotos reals -->
    <div class="relative" data-reveal>
      <div class="bezel" data-parallax="0.06">
        <div class="bezel-core grid grid-cols-3 grid-rows-3 gap-2.5 p-2.5">
          {
            tiles.map((tile) => (
              <div class={`${tile.c} ${tile.span} aspect-square overflow-hidden rounded-[12px]`} />
            ))
          }
        </div>
      </div>
      <span
        class="absolute -bottom-3 left-1/2 -translate-x-1/2 whitespace-nowrap rounded-full border border-sand bg-bg/90 px-3 py-1 text-[0.68rem] font-medium text-ink-soft backdrop-blur-sm"
      >
        {lang === 'ca' ? 'PLACEHOLDER · feed real del teu negoci' : 'PLACEHOLDER · feed real de tu negocio'}
      </span>
    </div>
  </div>
</section>
