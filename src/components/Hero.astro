---
import { ui, type Lang } from '../lib/i18n';
import { whatsappLink } from '../lib/config';
import ImageTrail from './ImageTrail.astro';
import luthier from '../assets/guitarras/luthier-retrat.png';
import flatlay from '../assets/guitarras/flatlay-tapa.png';
import roseta from '../assets/guitarras/roseta-detall.png';
import clamps from '../assets/guitarras/clamps-roseta.png';
import eines from '../assets/guitarras/eines-formons.png';
import cos from '../assets/guitarras/cos-encolat.png';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
const wa = whatsappLink(lang);

// Fotos reals del case study (taller de guitarres) per al rastre.
const trailImages = [
  { src: cos.src, alt: '' },
  { src: roseta.src, alt: '' },
  { src: clamps.src, alt: '' },
  { src: eines.src, alt: '' },
  { src: flatlay.src, alt: '' },
  { src: luthier.src, alt: '' },
];
const restingImages = trailImages.slice(0, 4);

const hintText = lang === 'ca' ? 'Mou el cursor pel hero' : 'Mueve el cursor por el hero';
---

<section class="aura relative overflow-hidden">
  <ImageTrail
    images={trailImages}
    threshold={46}
    minDelay={26}
    duration={1100}
    maxItems={14}
    rotationRange={34}
    class="block"
  >
    <div
      class="container-edge flex min-h-[80vh] flex-col justify-center pb-20 pt-32 md:min-h-[88vh] md:pt-40"
    >
      <div class="relative z-40 max-w-3xl">
        <p class="eyebrow" data-reveal>
          <span class="inline-block h-1.5 w-1.5 animate-float rounded-full bg-accent"></span>
          {t.hero.eyebrow}
        </p>
        <h1 class="mt-6 font-display text-mega font-semibold" data-reveal>
          {t.hero.title}
        </h1>
        <p class="lead mt-6" data-reveal>
          {t.hero.lead}
        </p>
        <div class="mt-9 flex flex-col items-start gap-3 sm:flex-row sm:items-center" data-reveal>
          <a href={wa} rel="noopener" class="btn-primary" data-magnetic>
            {t.hero.ctaPrimary}
            <span class="btn-ico" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91S17.5 2 12.04 2Zm5.8 14.16c-.24.68-1.4 1.3-1.93 1.38-.49.07-1.12.1-1.8-.11-.42-.13-.95-.31-1.64-.61-2.88-1.24-4.76-4.14-4.9-4.33-.14-.19-1.17-1.56-1.17-2.97s.74-2.11 1-2.4c.26-.29.57-.36.76-.36l.55.01c.18.01.41-.07.64.49.24.58.82 2 .89 2.14.07.14.12.31.02.5-.43.84-.88 1.05-.41.93-.12.58.17.29.74 1.22 1.59 1.98 1.09.97 2.01 1.27 2.3 1.42.29.14.46.12.63-.07.17-.19.72-.84.91-1.13.19-.29.39-.24.64-.14.26.09 1.66.78 1.95.93.29.14.48.21.55.34.07.12.07.72-.17 1.4Z"/></svg>
            </span>
          </a>
          <a href="#feina" class="btn-secondary" data-magnetic>
            {t.hero.ctaSecondary}
            <span class="btn-ico" aria-hidden="true">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </span>
          </a>
        </div>
        <p class="mt-7 flex items-center gap-2 text-sm text-ink-soft/90" data-reveal>
          <span class="relative flex h-2 w-2">
            <span class="pulse-dot absolute inline-flex h-full w-full rounded-full bg-accent/60"></span>
            <span class="relative inline-flex h-2 w-2 rounded-full bg-accent"></span>
          </span>
          {t.hero.trust}
        </p>
      </div>

      <!-- Collage del case study · només mòbil (sense hover) -->
      <div class="relative z-40 mt-12 grid grid-cols-2 gap-2 lg:hidden">
        {
          restingImages.map((im) => (
            <img
              src={im.src}
              alt={im.alt}
              loading="lazy"
              draggable={false}
              class="aspect-square w-full rounded-xl object-cover"
            />
          ))
        }
      </div>
    </div>

    <!-- Hint d'interacció a tot el hero (només desktop) -->
    <span
      class="pointer-events-none absolute bottom-5 right-5 z-40 hidden items-center gap-1.5 rounded-full bg-ink/80 px-3 py-1.5 text-[0.7rem] font-medium text-bg backdrop-blur-sm lg:inline-flex"
    >
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3 3 7.07 16.97 2.51-7.39 7.39-2.51L3 3z"/></svg>
      {hintText}
    </span>
  </ImageTrail>
</section>
