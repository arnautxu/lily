---
import { ui, type Lang } from '../lib/i18n';
import { site, contact, instagramLink } from '../lib/config';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
const year = 2026; // PLACEHOLDER · actualitza l'any si cal
---

<footer class="border-t border-sand bg-bg py-16">
  <div class="container-edge grid gap-10 md:grid-cols-[1.4fr_1fr_1fr]">
    <div class="max-w-xs">
      <p class="font-display text-lg font-semibold">
        {site.brand}<span class="text-accent">.</span>
      </p>
      <p class="mt-3 text-sm text-ink-soft">{t.footer.tagline}</p>
    </div>

    <nav aria-label={t.footer.nav}>
      <h3 class="text-xs font-semibold uppercase tracking-wide text-ink-soft">{t.footer.nav}</h3>
      <ul class="mt-3 grid gap-2 text-sm">
        {
          t.nav.links.map((l) => (
            <li>
              <a href={l.href} class="text-ink transition-colors hover:text-accent-ink">{l.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div>
      <h3 class="text-xs font-semibold uppercase tracking-wide text-ink-soft">{t.footer.contactTitle}</h3>
      <ul class="mt-3 grid gap-2 text-sm">
        <li><a href={`mailto:${contact.email}`} class="text-ink transition-colors hover:text-accent-ink">{contact.email}</a></li>
        <li><a href={instagramLink} rel="noopener" class="text-ink transition-colors hover:text-accent-ink">@{contact.instagram}</a></li>
        <li class="text-ink-soft">{contact.city}, {contact.region}</li>
      </ul>
    </div>
  </div>

  <div class="container-edge mt-10 flex flex-col items-center justify-between gap-2 border-t border-sand/60 pt-6 text-xs text-ink-soft sm:flex-row">
    <p>© {year} {site.brand} · {site.tagline}. {t.footer.rights}</p>
    <p class="inline-flex items-center gap-1.5">
      {t.footer.madeIn}
      <span class="inline-block h-1.5 w-1.5 rounded-full bg-coral" aria-hidden="true"></span>
    </p>
  </div>
</footer>
